# Скопируйте в .env (он в .gitignore) и заполните. Сам template.env коммитится, поэтому настоящих паролей здесь нет.
# Секреты сгенерировать так: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=change_me
CSRF_SECRET=change_me
DB_HOST=127.0.0.1
DB_NAME=web_buh
DB_PASSWORD=change_me
DB_PORT=3306
DB_USER=web_buh
DEBUG=false
HOST=0.0.0.0
# true нужно только скрипту инициализации БД, для приложения держите false
MULTIPLE_STATEMENTS=false
# development или production; в production cookie ставятся только по https
NODE_ENV=development
PEPPER=change_me
PORT=3000
SESSION_SECRET=change_me
# true, если сервер стоит за nginx или другим прокси
TRUST_PROXY=false
