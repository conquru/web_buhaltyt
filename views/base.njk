<!DOCTYPE html>
<html lang="ru" data-bs-theme="light">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="csrf-token" content="{{ csrfToken }}">
        <script src="/js/theme.js"></script>
        <link rel="icon" href="/img/logo.svg" type="image/svg+xml">
        <link rel="preload" href="/fonts/inter/inter-cyrillic-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
        <link rel="stylesheet" href="/css/bootstrap.min.css">
        <link rel="stylesheet" href="/ico/bootstrap-icons/bootstrap-icons.css">
        <link rel="stylesheet" href="/css/base.css">
        {% block css %}{% endblock %}
        <title>{{ title }} · buhaltyt</title>
    </head>
    <body data-websocket="{{ websocket }}">
        {% include "includes/header.njk" %}
        <div class="app">
            {% include "includes/sidebar.njk" %}
            <main class="app-main">
                {% block content %}{% endblock %}
            </main>
        </div>
        <script src="/js/bootstrap.bundle.min.js" defer></script>
        <script src="/js/base.js"></script>
        {% if websocket %}
        <script src="/js/wss.js"></script>
        {% endif %}
        {% block js %}{% endblock %}
    </body>
</html>
