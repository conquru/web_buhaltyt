{% extends "base.njk" %}

{% block css %}
    <link rel="stylesheet" href="/css/auth.css">
    <link rel="stylesheet" href="/css/register.css">
{% endblock %}

{% block js %}
    <script src="/js/register.js"></script>
{% endblock %}

{% block content %}
    <div class="auth">
        <div class="auth-card">
            <img src="/img/logo.svg" alt="" class="auth-logo" width="48" height="48">
            <h1 class="auth-title">Регистрация</h1>
            <p class="auth-subtitle">Пара полей - и вы в компании.</p>
            <form method="post" id="form" class="auth-form" novalidate>
                <label for="email" class="visually-hidden">email</label>
                <input
                        type="text"
                        name="email"
                        autocomplete="email"
                        inputmode="email"
                        id="email"
                        class="form-control form-control-pill"
                        placeholder="email"
                        value="{{ formData.email }}"
                        required
                >
                <label for="username" class="visually-hidden">Имя пользователя</label>
                <input
                        type="text"
                        name="username"
                        autocomplete="username"
                        id="username"
                        class="form-control form-control-pill"
                        placeholder="Имя пользователя"
                        value="{{ formData.username }}"
                        required
                >
                <label for="phone" class="visually-hidden">Номер телефона</label>
                <input
                        type="text"
                        name="phone"
                        autocomplete="tel"
                        inputmode="tel"
                        id="phone"
                        class="form-control form-control-pill"
                        placeholder="Номер телефона"
                        value="{{ formData.phone }}"
                        required
                >
                <div>
                    <div class="password-field">
                        <label for="password" class="visually-hidden">Пароль</label>
                        <input
                                type="password"
                                name="password"
                                autocomplete="new-password"
                                id="password"
                                class="form-control form-control-pill"
                                placeholder="Пароль"
                                value="{{ formData.password }}"
                                required
                        >
                        <button type="button" class="eye" id="eye-button" aria-label="Показать пароль">
                            <i class="bi bi-eye" id="eye-icon"></i>
                        </button>
                    </div>
                    <progress
                            id="progress"
                            value="0"
                            max="100"
                            class="password-progress"
                            aria-label="Надёжность пароля"
                            hidden
                    ></progress>
                    <p class="password-hint">Минимум 10 символов: строчные и заглавные буквы, цифра и спецсимвол.</p>
                </div>
                <button type="submit" class="btn btn-pill btn-accent btn-auth">Зарегистрироваться</button>
                <div class="alert alert-danger mb-0" id="error" role="alert" hidden></div>
            </form>
            <p class="auth-switch">Уже есть аккаунт? <a href="/login">Войти</a></p>
        </div>
    </div>
{% endblock %}
