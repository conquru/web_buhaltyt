{% extends "base.njk" %}

{% block css %}
    <link rel="stylesheet" href="/css/register.css">
{% endblock %}

{% block js %}
    <script src="/js/register.js"></script>
{% endblock %}

{% block content %}
    <div class="container form">
        <div class="row justify-content-center">
            <form method="post" id="form" novalidate>
                <h2>Регистрация</h2>
                <label for="email" class="visually-hidden">email</label>
                <input
                        type="email"
                        name="email"
                        id="email"
                        class="form-control rounded-pill mb-2"
                        placeholder="email"
                        value="{{ formData.email }}"
                        required
                >
                <label for="username" class="visually-hidden">Имя пользователя</label>
                <input
                        type="text"
                        name="username"
                        id="username"
                        class="form-control rounded-pill mb-2"
                        placeholder="Имя пользователя"
                        value="{{ formData.username }}"
                        required
                >
                <label for="phone" class="visually-hidden">Номер телефона</label>
                <input
                        type="tel"
                        name="phone"
                        id="phone"
                        class="form-control rounded-pill mb-2"
                        placeholder="Номер телефона"
                        value="{{ formData.phone }}"
                        required
                >
                <div class="password-wrapper position-relative">
                    <label for="password" class="visually-hidden">Пароль</label>
                    <input
                            type="password"
                            name="password"
                            id="password"
                            class="form-control rounded-pill password-input pe-5"
                            placeholder="Пароль"
                            value="{{ formData.password }}"
                            required
                    >
                    <progress
                            id="progress"
                            value="0"
                            max="100"
                            class="password-progress"
                            hidden
                    ></progress>
                    <button
                            type="button"
                            class="btn btn-link position-absolute top-50 end-0 translate-middle-y me-3 eye"
                            onclick="togglePassword()"
                            id="eye-button"
                    >
                        <i class="bi bi-eye fs-5" id="eye-icon"></i>
                    </button>
                </div>
                <button type="submit" class="btn btn-primary rounded-pill form-control mb-2 mt-1">
                    Зарегистрироваться
                </button>
                <div class="alert alert-danger rounded-4" id="error" role="alert" hidden></div>
            </form>
        </div>
    </div>
{% endblock %}
