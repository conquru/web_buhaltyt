{% set imagesCount = post.images.length %}
<article class="post {{ 'is-open' if post.isCommentsOpened else '' }}">
    <header class="post-header">
        <img src="/{{ users[post.user].avatar }}" alt="" class="avatar avatar-sm">
        <span class="post-author">{{ users[post.user].name }}</span>
        <span aria-hidden="true">•</span>
        <time>{{ post.time }}</time>
    </header>
    {% if post.title %}
        <h2 class="post-title">{{ post.title }}</h2>
    {% endif %}
    <p class="post-text">{{ post.text }}</p>
    {% if imagesCount %}
        <div class="image-grid" data-count="{{ imagesCount if imagesCount < 4 else 4 }}">
            {% for image in post.images %}
                {% if loop.index <= 4 %}
                    <div class="grid-item">
                        <img src="/{{ image }}" alt="" loading="lazy">
                        {% if loop.index == 4 and imagesCount > 4 %}
                            <span class="grid-more">+{{ imagesCount - 4 }}</span>
                        {% endif %}
                    </div>
                {% endif %}
            {% endfor %}
        </div>
    {% endif %}
    <footer class="post-actions">
        <div class="vote-pill {{ 'is-liked' if post.isLiked else '' }} {{ 'is-disliked' if post.isDisliked else '' }}">
            <button class="vote-btn vote-like" type="button" aria-label="Нравится"
                    aria-pressed="{{ 'true' if post.isLiked else 'false' }}">
                <i class="bi bi-heart{{ '-fill' if post.isLiked else '' }}"></i>
                <span class="like-count">{{ post.likes.length if post.likes.length > 0 else '' }}</span>
            </button>
            <span class="vote-divider" aria-hidden="true"></span>
            <button class="vote-btn vote-dislike" type="button" aria-label="Не нравится"
                    aria-pressed="{{ 'true' if post.isDisliked else 'false' }}">
                <i class="bi bi-hand-thumbs-down{{ '-fill' if post.isDisliked else '' }}"></i>
                <span class="like-count">{{ post.dislikes.length if post.dislikes.length > 0 else '' }}</span>
            </button>
        </div>
        <button class="action-pill" type="button" aria-label="Комментарии" {{ '' if post.comments.length > 0 else 'disabled' }}>
            <i class="bi bi-chat{{ '-fill' if post.isCommentsOpened else '' }}"></i>
            <span class="like-count">{{ post.comments.length if post.comments.length > 0 else '' }}</span>
        </button>
    </footer>
    {% if post.isCommentsOpened and post.comments.length > 0 %}
        <section class="comments" aria-label="Комментарии">
            {% for comment in post.parent_comments %}
                {% include "includes/comments.njk" %}
            {% endfor %}
        </section>
    {% endif %}
    <div class="comment-box">
        <label class="flex-grow-1">
            <span class="visually-hidden">Комментарий</span>
            <input class="form-control comment-input" type="text" placeholder="Добавьте комментарий">
        </label>
        <button class="btn btn-icon btn-accent" type="button" aria-label="Отправить">
            <i class="bi bi-send"></i>
        </button>
    </div>
</article>
