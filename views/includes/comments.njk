{% macro commentActions(item) %}
    <div class="comment-actions">
        <button class="comment-action {{ 'is-liked' if item.isLiked else '' }}" type="button" aria-label="Нравится"
                aria-pressed="{{ 'true' if item.isLiked else 'false' }}">
            <i class="bi bi-heart{{ '-fill' if item.isLiked else '' }}"></i>
            <span>{{ item.likes.length if item.likes.length > 0 else '' }}</span>
        </button>
        <button class="comment-action {{ 'is-disliked' if item.isDisliked else '' }}" type="button"
                aria-label="Не нравится" aria-pressed="{{ 'true' if item.isDisliked else 'false' }}">
            <i class="bi bi-hand-thumbs-down{{ '-fill' if item.isDisliked else '' }}"></i>
            <span>{{ item.dislikes.length if item.dislikes.length > 0 else '' }}</span>
        </button>
        <button class="comment-action" type="button">
            <i class="bi bi-reply"></i>
            <span>Ответить</span>
        </button>
    </div>
{% endmacro %}
<div class="comment">
    <div class="comment-gutter">
        <img src="/{{ users[comment.user].avatar }}" alt="" class="avatar avatar-md">
        {% if comment.children.length %}
            <span class="thread-line" aria-hidden="true"></span>
        {% endif %}
    </div>
    <div class="comment-main">
        <div class="comment-meta">
            <span class="comment-author">{{ users[comment.user].name }}</span>
            <span aria-hidden="true">•</span>
            <time>{{ comment.time }}</time>
        </div>
        <p class="comment-text">{{ comment.text }}</p>
        {{ commentActions(comment) }}
        {% for child in comment.children %}
            <div class="comment comment-child">
                <div class="comment-gutter">
                    <img src="/{{ users[child.user].avatar }}" alt="" class="avatar avatar-sm">
                </div>
                <div class="comment-main">
                    <div class="comment-meta">
                        <span class="comment-author">{{ users[child.user].name }}</span>
                        <i class="bi bi-caret-right-fill reply-arrow" aria-label="в ответ"></i>
                        <span>{{ users[child.parent].name }}</span>
                        <span aria-hidden="true">•</span>
                        <time>{{ child.time }}</time>
                    </div>
                    <p class="comment-text">{{ child.text }}</p>
                    {{ commentActions(child) }}
                </div>
            </div>
        {% endfor %}
    </div>
</div>
