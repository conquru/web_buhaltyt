{% extends "base.njk" %}

{% block css %}
    <link rel="stylesheet" href="/css/upload.css">
{% endblock %}

{% block content %}
    <div class="page">
        <div class="page-content">
            <h1 class="page-title">Создать пост</h1>
            <section class="composer">
                <form method="post" enctype="multipart/form-data" id="form">
                    <input type="file" name="image" id="image" accept="image/*" hidden multiple>
                    <label for="textarea" class="visually-hidden">Текст поста</label>
                    <textarea class="form-control composer-text" placeholder="Что нового?"
                              id="textarea" maxlength="2000" name="text" required></textarea>
                </form>
                <button class="dropzone" type="button" id="btn-image">
                    <i class="bi bi-images"></i>
                    <span>Перетащите фото сюда или <span class="dropzone-link">выберите файлы</span></span>
                    <small>До 10 фото, каждое не больше 500 КБ</small>
                </button>
                <div class="preview-strip" id="preview-img"></div>
                <div class="composer-footer">
                    <a class="btn btn-pill btn-ghost" href="/feed">Отмена</a>
                    <button class="btn btn-pill btn-accent" type="button" id="btn-submit">Опубликовать</button>
                </div>
            </section>
            <div class="alert alert-danger mt-3" id="error" role="alert" hidden></div>
        </div>
        {% include "includes/aside.njk" %}
    </div>
{% endblock %}

{% block js %}
    <script type="module" src="/js/upload.js"></script>
{% endblock %}
