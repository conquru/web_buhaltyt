{% extends "base.njk" %}

{% block js %}
    <script src="/js/login.js"></script>
{% endblock %}

{% block content %}
    <div class="container form">
        <div class="row justify-content-center">
            <form method="post" novalidate>
                <h2>Регистрация</h2>
                <label for="email" id="email-err"></label>
                <input
                        type="email"
                        name="email"
                        id="email"
                        class="form-control rounded-pill mb-2"
                        placeholder="email"
                        value="{{ formData.email }}"
                        required
                >
                <label for="username" id="username-err"></label>
                <input
                        type="text"
                        name="username"
                        id="username"
                        class="form-control rounded-pill mb-2"
                        placeholder="Имя пользователя"
                        value="{{ formData.username }}"
                        required
                >
                <label for="phone" id="phone-err"></label>
                <input
                        type="tel"
                        name="phone"
                        id="phone"
                        class="form-control rounded-pill mb-2"
                        placeholder="Номер телефона"
                        value="{{ formData.phone }}"
                        required
                >
                <div class="position-relative">
                    <label for="password" id="password-err"></label>
                    <input
                            type="password"
                            name="password"
                            id="password"
                            class="form-control rounded-pill mb-3 pe-5"
                            placeholder="Пароль"
                            value="{{ formData.password }}"
                            required
                    >
                    <button
                            type="button"
                            class="btn btn-link position-absolute top-50 end-0 translate-middle-y me-3 eye"
                            onclick="togglePassword()"
                            id="eye-button"
                    >
                        <i class="bi bi-eye fs-5" id="eye-icon"></i>
                    </button>
                </div>
                <button type="submit" class="btn btn-primary rounded-pill form-control mb-2">
                    Зарегистрироваться
                </button>
                {% if error %}
                    <div class="alert alert-danger" role="alert">{{ error }}</div>
                {% endif %}
            </form>
        </div>
    </div>
{% endblock %}
