{% extends "base.njk" %}

{% block css %}
    <link rel="stylesheet" href="/css/register.css">
{% endblock %}

{% block js %}
    <script src="/js/register.js"></script>
{% endblock %}

{% block content %}
    <div class="container form">
        <div class="row justify-content-center">
            <form method="post" id="form" novalidate>
                <h2>Регистрация</h2>
                <input
                        type="email"
                        name="email"
                        id="email"
                        class="form-control rounded-top mb-2"
                        placeholder="email"
                        value="{{ formData.email }}"
                        required
                >
                <input
                        type="text"
                        name="username"
                        id="username"
                        class="form-control rounded-top mb-2"
                        placeholder="Имя пользователя"
                        value="{{ formData.username }}"
                        required
                >
                <input
                        type="tel"
                        name="phone"
                        id="phone"
                        class="form-control rounded-top mb-2"
                        placeholder="Номер телефона"
                        value="{{ formData.phone }}"
                        required
                >
                <div class="position-relative">
                    <input
                            type="password"
                            name="password"
                            id="password"
                            {# class="form-control rounded-top mb-0 pe-5" #}
                            class="form-control rounded-top password-input pe-5"
                            placeholder="Пароль"
                            value="{{ formData.password }}"
                            required
                    >
                    <button
                            type="button"
                            class="btn btn-link position-absolute top-50 end-0 translate-middle-y me-3 eye"
                            onclick="togglePassword()"
                            id="eye-button"
                    >
                        <i class="bi bi-eye fs-5" id="eye-icon"></i>
                    </button>
                </div>
                {# <progress id="progress" value="0" max="100" class="progress mt-0 mb-1" hidden></progress> #}
                <progress id="progress" value="0" max="100" class="password-progress" hidden></progress>
                <button type="submit" class="btn btn-primary rounded-top form-control mb-2 mt-1">
                    Зарегистрироваться
                </button>
                <div class="alert alert-danger" id="error" role="alert" hidden></div>
            </form>
        </div>
    </div>
{% endblock %}
