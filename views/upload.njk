{% extends "base.njk" %}

{% block css %}
    <link rel="stylesheet" href="/css/upload.css">
{% endblock %}

{% block content %}
<div class="card border-2 border-grey rounded-5 col-12 col-sm-11 col-md-10 col-lg-9 col-xl-8 col-xxl-7 mx-auto">
    <div class="card-header rounded-top-5">
        <h5 class="mt-2 ms-3">Новый пост</h5>
    </div>
    <div class="card-body">
        <form method="POST" enctype="multipart/form-data" id="form">
{#            {% csrf_token %}#}
            <input type="file" name="image" id="image" accept="image/*" hidden multiple>
            <textarea class="form-control border-0 mb-2 rounded-4" placeholder="Напишите что-нибудь..." id="textarea"
                      maxlength="2000" name="text"></textarea>
        </form>
        <div class="overflow-x-auto d-flex flex-nowrap gap-2" id="preview-img"></div>
        <div class="d-flex align-items-center mt-3">
            <div class="d-flex justify-content-start flex-grow-1">
                <button class="btn btn-upload border-0 bg-transparent ps-2" id="btn-image">
                    <i class="bi bi-image"></i>
                </button>
            </div>
            <button class="btn btn-primary rounded-pill" id="btn-submit">Опубликовать</button>
        </div>
    </div>
</div>
<div class="alert alert-danger rounded-4" id="error" role="alert" hidden></div>
{% endblock %}

{% block js %}
    <script type="module" src="/js/upload.js"></script>
{% endblock %}
